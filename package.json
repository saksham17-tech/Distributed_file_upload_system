{
  "name": "distributed-upload-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspaces",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "db:generate": "npm run db:generate --workspace=@upload-system/database",
    "db:push": "npm run db:push --workspace=@upload-system/database"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "turbo": "^2.0.0"
  }
}
